# Copy to .env locally. Do not commit real keys.
LUMASIFT_INPUT_DIR=./sample_photos
LUMASIFT_OUTPUT_DIR=./outputs
LUMASIFT_AI_MODE=local_only
LUMASIFT_TOP_N_API_ANALYSIS=20

# OpenAI-compatible Qwen gateway. Multiple keys are comma-separated.
LUMASIFT_VISION_API_BASE_URL=https://api.newcoin.top/v1
LUMASIFT_VISION_MODEL=qwen3.6-plus
LUMASIFT_VISION_API_KEYS=
LUMASIFT_VISION_MAX_TOKENS=4096
